# =============================================
# DeepTravel —— API 配置模板
# 复制为 .env 并填入真实值（.env 不要提交）
# =============================================

# 主 LLM：阿里云 DashScope 通义千问
DASHSCOPE_API_KEY=your_dashscope_api_key
# 常用模型：qwen-max（旗舰）、qwen-plus（平衡）、qwen-turbo（快速）
DASHSCOPE_MODEL=qwen-max

# 高德地图 API（Itinerary Agent：POI 搜索 / 路径规划）
AMAP_API_KEY=your_amap_api_key

# 心知天气 API（Safety Agent：目的地天气）
SENIVERSE_API_KEY=your_seniverse_api_key

# 飞猪 API（预留：价格查询）
FLIGGY_API_KEY=your_fliggy_api_key

# Mock 开关：false = 真实 LLM + 真实工具；true = 全部 mock
MOCK_LLM=false
