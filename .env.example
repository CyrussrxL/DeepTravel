# =============================================
# DeepTravel —— API 配置模板
# 复制为 .env 并填入你的真实值（.env 已被 .gitignore 排除，不会提交）
# =============================================

# 主 LLM：阿里云 DashScope 通义千问（OpenAI 兼容端点）
DASHSCOPE_API_KEY=your_dashscope_api_key
# 模型名（必填）：填入你在阿里云百炼开通、想使用的模型名
DASHSCOPE_MODEL=
# 端点一般不用改；私有化部署时替换
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 思考模式（部分模型默认开，会占用 output token 预算，建议 false）
# DASHSCOPE_ENABLE_THINKING=false
# 单次生成 token 上限（中文长报告 ≈1.5 字/token，建议 8000）
# DASHSCOPE_MAX_TOKENS=8000

# 可选兜底：原生 OpenAI 端点（未配置 DASHSCOPE_API_KEY 时启用）
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=

# 高德地图 API（Itinerary Agent：POI 搜索 / 路径规划）
# https://console.amap.com/
AMAP_API_KEY=your_amap_api_key

# 心知天气 API（Safety Agent：目的地天气）
# https://www.seniverse.com/
SENIVERSE_API_KEY=your_seniverse_api_key

# Mock 开关：false = 真实 LLM + 真实工具；true = 全部 mock（秒级验证流程，无需任何 Key）
MOCK_LLM=false
